      "targets": [
        {
          "rawSql": "SELECT round(avg(judge_faithfulness)::numeric, 2) AS avg_faithfulness FROM monitoring.conversations WHERE judge_faithfulness IS NOT NULL AND $__timeFilter(created_at)",
