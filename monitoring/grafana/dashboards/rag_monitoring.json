    {
      "id": 5,
      "type": "stat",
      "title": "Reranking usage rate",
      "datasource": { "type": "postgres", "uid": "postgres_ds" },
      "gridPos": { "h": 4, "w": 4, "x": 16, "y": 8 },
      "targets": [
        {
          "rawSql": "SELECT round(100.0 * sum(CASE WHEN use_rerank THEN 1 ELSE 0 END) / nullif(count(*), 0), 1) AS rerank_pct FROM monitoring.conversations WHERE $__timeFilter(created_at)",
          "format": "table",
          "refId": "A"
        }
      ],
      "fieldConfig": { "defaults": { "unit": "percent", "max": 100, "min": 0 }, "overrides": [] },
      "options": {}
    },
    {
      "id": 6,
      "type": "stat",
      "title": "Query-rewrite usage rate",
      "datasource": { "type": "postgres", "uid": "postgres_ds" },
      "gridPos": { "h": 4, "w": 4, "x": 20, "y": 8 },
      "targets": [
        {
          "rawSql": "SELECT round(100.0 * sum(CASE WHEN use_query_rewrite THEN 1 ELSE 0 END) / nullif(count(*), 0), 1) AS rewrite_pct FROM monitoring.conversations WHERE $__timeFilter(created_at)",
          "format": "table",
          "refId": "A"
        }
