      "targets": [
        {
          "rawSql": "SELECT created_at AS time, question, method, is_agentic, n_tool_calls, use_rerank, use_query_rewrite, latency_ms, judge_faithfulness, judge_context_precision, judge_relevance FROM monitoring.conversations ORDER BY created_at DESC LIMIT 20",
          "format": "table",
          "refId": "A"
        }
      ],
      "fieldConfig": { "defaults": {}, "overrides": [] },
      "options": {}
    },
    {
      "id": 11,
      "type": "table",
      "title": "Recent feedback comments",
      "datasource": { "type": "postgres", "uid": "postgres_ds" },
      "gridPos": { "h": 8, "w": 24, "x": 0, "y": 32 },
      "targets": [
        {
          "rawSql": "SELECT f.created_at AS time, c.question, f.is_positive, f.comment FROM monitoring.feedback f JOIN monitoring.conversations c ON c.id = f.conversation_id WHERE f.comment IS NOT NULL AND f.comment <> '' ORDER BY f.created_at DESC LIMIT 20",
          "format": "table",
          "refId": "A"
        }
      ],
      "fieldConfig": { "defaults": {}, "overrides": [] },
      "options": {}
