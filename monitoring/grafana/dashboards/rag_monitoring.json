  "panels": [
    {
      "id": 1,
      "type": "timeseries",
      "title": "Conversations over time",
      "datasource": { "type": "postgres", "uid": "postgres_ds" },
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 0 },
      "targets": [
        {
          "rawSql": "SELECT date_trunc('hour', created_at) AS time, count(*) AS conversations FROM monitoring.conversations WHERE $__timeFilter(created_at) GROUP BY 1 ORDER BY 1",
          "format": "time_series",
          "refId": "A"
        }
      ],
      "fieldConfig": { "defaults": {}, "overrides": [] },
      "options": {}
    },
    {
      "id": 2,
      "type": "timeseries",
      "title": "Average latency (ms)",
      "datasource": { "type": "postgres", "uid": "postgres_ds" },
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 0 },
      "targets": [
        {
          "rawSql": "SELECT date_trunc('hour', created_at) AS time, avg(latency_ms) AS avg_latency_ms FROM monitoring.conversations WHERE $__timeFilter(created_at) GROUP BY 1 ORDER BY 1",
          "format": "time_series",
          "refId": "A"
        }
      ],
      "fieldConfig": { "defaults": { "unit": "ms" }, "overrides": [] },
      "options": {}
    },
    {
      "id": 3,
      "type": "piechart",
      "title": "Feedback: thumbs up vs down",
      "datasource": { "type": "postgres", "uid": "postgres_ds" },
      "gridPos": { "h": 8, "w": 8, "x": 0, "y": 8 },
      "targets": [
        {
          "rawSql": "SELECT CASE WHEN is_positive THEN 'Thumbs up' ELSE 'Thumbs down' END AS metric, count(*) AS value FROM monitoring.feedback WHERE $__timeFilter(created_at) GROUP BY 1",
          "format": "table",
          "refId": "A"
        }
      ],
      "fieldConfig": { "defaults": {}, "overrides": [] },
      "options": {
        "legend": { "displayMode": "list", "placement": "bottom" },
        "reduceOptions": { "values": true, "calcs": ["lastNotNull"], "fields": "" }
      }
    },
    {
      "id": 4,
      "type": "piechart",
      "title": "Retrieval method usage",
      "datasource": { "type": "postgres", "uid": "postgres_ds" },
      "gridPos": { "h": 8, "w": 8, "x": 8, "y": 8 },
      "targets": [
        {
          "rawSql": "SELECT method AS metric, count(*) AS value FROM monitoring.conversations WHERE $__timeFilter(created_at) GROUP BY 1",
          "format": "table",
          "refId": "A"
        }
      ],
      "fieldConfig": { "defaults": {}, "overrides": [] },
