      "gridPos": { "h": 8, "w": 8, "x": 16, "y": 16 },
      "targets": [
        {
          "rawSql": "SELECT judge_relevance AS metric, count(*) AS value FROM monitoring.conversations WHERE judge_relevance IS NOT NULL AND $__timeFilter(created_at) GROUP BY 1",
