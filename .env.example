# Copy this file to .env and fill in your values
# Never commit .env

# Gemini API key (free tier) — https://aistudio.google.com/apikey
GEMINI_API_KEY=your_gemini_api_key_here

# SEC EDGAR User-Agent (required by SEC fair-access policy; use your real name and email)
SEC_USER_NAME=Your Name
SEC_USER_EMAIL=your_email@example.com

# Postgres — shared by the dlt ingestion staging tables and the monitoring/feedback
# tables (see PLAN.md). These defaults match the docker-compose "postgres" service.
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_DB=sec_rag
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
